MAIL_USERNAME=your-mailtrap-username
MAIL_PASSWORD=your-mailtrap-password
# Base64-encoded 256-bit key, e.g. from: openssl rand -base64 32
JWT_SECRET=your-base64-jwt-secret
# Comma-separated browser origins allowed by CORS (no wildcard). Defaults to the local React/Vite dev servers.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Base URL of the frontend app (no path). Password reset emails link to <FRONTEND_URL>/reset-password?token=...
# Optional; defaults to the local Vite dev server.
FRONTEND_URL=http://localhost:5173
