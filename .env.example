MAIL_USERNAME=your-mailtrap-username
MAIL_PASSWORD=your-mailtrap-password
# Base64-encoded 256-bit key, e.g. from: openssl rand -base64 32
JWT_SECRET=your-base64-jwt-secret
# Token lifetimes (optional). Access tokens (JWTs) cannot be revoked, so keep them short; refresh tokens are
# single-use, rotated on every refresh and revoked on logout or password change.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d
# Comma-separated browser origins allowed by CORS (no wildcard). Defaults to the local React/Vite dev servers.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Base URL of the frontend app (no path). Password reset emails link to <FRONTEND_URL>/reset-password?token=...
# and verification emails to <FRONTEND_URL>/verify-email?token=...
# Optional; defaults to the local Vite dev server.
FRONTEND_URL=http://localhost:5173
# Static bearer token a Prometheus server uses to scrape /actuator/prometheus (Authorization: Bearer <token>).
# At least 32 characters, e.g. from: openssl rand -hex 32. Empty (the default here, so a copied example never
# works as a real token) = only ADMIN JWTs can read the metrics.
METRICS_TOKEN=
# Console log format: json (Elastic Common Schema, one object per line) or text (default). docker-compose sets json.
LOG_FORMAT=text
